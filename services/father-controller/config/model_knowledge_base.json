    {
      "stage": 2,
      "condition": "general analysis, RAG synthesis, Russian text, JSON/structured output",
      "prefer": [
        "qwen-analysis"
      ]
    },
    {
      "stage": 3,
      "condition": "code generation, repair, code reasoning",
      "prefer": [
        "qwen-coder"
      ]
    },
    {
      "stage": 4,
      "condition": "deep multi-step reasoning or difficult planning",
      "prefer": [
        "deepseek-reasoning"
      ]
    },
    {
      "stage": 5,
      "condition": "image/document/chart understanding is required",
      "prefer": [
        "qwen3-vl-vision",
        "llava-vision"
      ]
    },
    {
      "stage": 6,
      "condition": "no single model satisfies requirements",
      "prefer": [
        "multi-brain handoff"
      ]
    }
  ],
