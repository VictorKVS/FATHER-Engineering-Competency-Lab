    "complexity_levels": {
      "1": "simple transform/classification/extraction/short summarization",
      "2": "general QA, RAG synthesis, structured output, routine architecture",
      "3": "specialized coding or multi-constraint analysis",
      "4": "deep multi-step reasoning, difficult planning, adversarial/critical analysis"
    },
    "specializations": [
      "general",
      "rag",
      "coding",
      "reasoning",
      "edge",
      "vision",
      "structured_output"
    ],
    "latency_classes": [
      "fast",
      "medium",
      "slow"
    ],
    "resource_classes": [
      "light",
      "medium",
      "heavy"
    ]
  },
  "decision_ladder": [
    {
      "stage": 1,
      "condition": "task is simple, local, text-only, low risk",
      "prefer": [
        "llama-small"
      ]
